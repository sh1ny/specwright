+fn trace_request_tools(request: &ResponsesApiRequest, thread_id: ThreadId, responses_lite: bool) {
+    let Some(dir) = std::env::var_os("SPECWRIGHT_ISOLATION_TRACE_DIR") else {
+        return;
+    };
+    #[derive(serde::Serialize)]
+    struct Event<'a> {
+        event: &'static str,
+        thread_id: ThreadId,
+        model: &'a str,
+        responses_lite: bool,
+        tools: &'a Option<codex_api::ResponsesApiTools>,
+        additional_tools: Vec<&'a ResponseItem>,
+    }
+    let event = Event {
+        event: "responses_request_tools",
+        thread_id,
+        model: &request.model,
+        responses_lite,
+        tools: &request.tools,
+        additional_tools: request
+            .input
+            .iter()
+            .filter(|item| matches!(item, ResponseItem::AdditionalTools { .. }))
+            .collect(),
+    };
+    write_isolation_trace(&dir, "responses-tools", &event);
+}
+
+fn write_isolation_trace<T: serde::Serialize>(dir: &std::ffi::OsStr, kind: &str, event: &T) {
+    use std::io::Write as _;
+    use std::sync::atomic::AtomicU64;
+    static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+    let result = (|| -> std::result::Result<(), Box<dyn std::error::Error>> {
+        let bytes = serde_json::to_vec(event)?;
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)?
+            .as_nanos();
+        let path = std::path::Path::new(dir).join(format!(
+            "{kind}-{}-{nanos}-{}.json",
+            std::process::id(),
+            COUNTER.fetch_add(1, Ordering::Relaxed)
+        ));
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(&path)?;
+        if let Err(error) = file.write_all(&bytes) {
+            drop(file);
+            if let Err(cleanup_error) = std::fs::remove_file(&path) {
+                eprintln!("SPECWRIGHT isolation trace: failed to remove incomplete event: {cleanup_error}");
+            }
+            return Err(error.into());
+        }
+        Ok(())
+    })();
+    if let Err(error) = result {
+        eprintln!("SPECWRIGHT isolation trace: failed to write {kind} event: {error}");
+    }
+}
 
