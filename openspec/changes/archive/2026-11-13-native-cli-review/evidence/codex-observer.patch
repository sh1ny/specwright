+fn trace_isolation_command_event(thread_id: &ThreadId, event: &Event) {
+    let Some(directory) = std::env::var_os("SPECWRIGHT_ISOLATION_TRACE_DIR") else {
+        return;
+    };
+    if !matches!(
+        &event.msg,
+        EventMsg::ExecCommandBegin(_) | EventMsg::ExecCommandEnd(_)
+    ) {
+        return;
+    }
+
+    use std::io::Write;
+
+    #[derive(serde::Serialize)]
+    struct CommandTrace<'a> {
+        thread_id: &'a ThreadId,
+        event_id: &'a str,
+        event: &'a EventMsg,
+    }
+
+    static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+    let report = |error: &dyn std::fmt::Display| {
+        let _ = writeln!(
+            std::io::stderr().lock(),
+            "SPECWRIGHT_ISOLATION_TRACE_DIR: failed to write command event: {error}"
+        );
+    };
+    let timestamp = match SystemTime::now().duration_since(UNIX_EPOCH) {
+        Ok(timestamp) => timestamp.as_nanos(),
+        Err(error) => {
+            report(&error);
+            return;
+        }
+    };
+    let record = CommandTrace {
+        thread_id,
+        event_id: &event.id,
+        event: &event.msg,
+    };
+    let bytes = match serde_json::to_vec(&record) {
+        Ok(bytes) => bytes,
+        Err(error) => {
+            report(&error);
+            return;
+        }
+    };
+    let sequence = SEQUENCE.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let path = PathBuf::from(directory).join(format!(
+        "command-event-{}-{timestamp}-{sequence}.json",
+        std::process::id()
+    ));
+    let mut file = match std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&path)
+    {
+        Ok(file) => file,
+        Err(error) => {
+            report(&error);
+            return;
+        }
+    };
+    if let Err(error) = file.write_all(&bytes) {
+        report(&error);
+        drop(file);
+        if let Err(error) = std::fs::remove_file(&path) {
+            let _ = writeln!(
+                std::io::stderr().lock(),
+                "SPECWRIGHT_ISOLATION_TRACE_DIR: failed to remove incomplete command event {}: {error}",
+                path.display()
+            );
+        }
+    }
+}
