__pycache__/
*.pyc

# Specwright installed into its own repo: copies of skills/, agents/,
# schemas/ and VERSION, refreshed by the install prompt (see README).
/.claude/skills/specwright-*/
/.claude/agents/specwright-*.md
/.omp/agents/specwright-*.md
/.agents/skills/specwright-*/
/openspec/schemas/specwright/
/openspec/.specwright/

# Staging directories of an interrupted `scripts/update.sh` run (removed when an update finishes).
.specwright-update-*/

# Generated by `openspec init`.
/.claude/commands/opsx/
/.claude/skills/openspec-*/
/openspec/config.yaml
/openspec/specs/.gitkeep
/openspec/changes/archive/.gitkeep
