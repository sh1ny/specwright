{
  "rules": [
    {"paths": ["skills/**"], "suites": ["git-workflow", "update"]},
    {"paths": ["skills/*/SKILL.md", "skills/specwright-release/**"], "suites": ["release"]},
    {"paths": ["skills/specwright-finish/**"], "suites": ["finish"]},
    {"paths": ["skills/specwright-pr/**", "skills/specwright-finish/SKILL.md", "skills/*/scripts/**"], "suites": ["pr-pair"]},
    {"paths": ["skills/specwright-review/**", "skills/specwright-commit/**", "skills/specwright-pr/**", "skills/specwright-finish/**", "skills/specwright-roadmap/**"], "suites": ["review-routes"]},
    {"paths": ["skills/specwright-pr/scripts/bounded.py"], "suites": ["runner"]},
    {"paths": ["schemas/**"], "suites": ["git-workflow", "release", "review-routes", "update"]},
    {"paths": ["templates/**"], "suites": ["git-workflow", "update"]},
    {"paths": ["packs/**"], "suites": ["packs", "update"]},
    {"paths": ["evals/packs/**"], "suites": ["packs"]},
    {"paths": ["scripts/**"], "suites": ["update", "packs"]},
    {"paths": ["agents/**"], "suites": ["git-workflow", "update"]},
    {"paths": ["agents/*/specwright-reviewer.md"], "suites": ["review-routes"]},
    {"paths": ["README.md"], "suites": ["git-workflow", "release"]},
    {"paths": ["CONTRIBUTING.md"], "suites": ["git-workflow", "runner"]},
    {"paths": ["VERSION"], "suites": ["release", "review-routes"]},
    {"paths": ["OPENSPEC_VERSION", ".gitignore"], "suites": ["git-workflow"]},
    {"paths": ["AGENTS.md", "CLAUDE.md", ".github/**"], "suites": ["runner"]},
    {"paths": ["openspec/**"], "suites": ["git-workflow/test_specs_strict.py"]},
    {"paths": ["evals/git-workflow/fixtures.py"], "suites": ["pr-pair"]},
    {"paths": ["evals/bashexe.py"], "suites": ["finish", "git-workflow", "pr-pair", "release", "review-routes", "runner", "update", "vcs"]},
    {"paths": ["evals/git-workflow/grade.py"], "suites": ["pr-pair/test_fake_gh.py"]},
    {"paths": ["evals/suites.json", "evals/timings.md", "evals/runner/**", "JJ_VERSION", "BUT_VERSION"], "suites": ["runner"]},
    {"paths": ["cli/**", "mise.toml", ".github/workflows/cli.yml", ".github/workflows/sw-build.yml", ".github/workflows/release.yml", "skills/specwright-pr/scripts/sw-path.sh", "scripts/install-sw.sh", "evals/cli/**", "evals/fakes/gh_release.py"], "suites": ["cli"]},
    {"paths": ["evals/finish/oracle/**"], "suites": ["finish", "vcs"]},
    {"paths": ["evals/pr-pair/oracle/**"], "suites": ["pr-pair"]},
    {"paths": ["evals/pr-pair/test_project_shims.py"], "suites": ["pr-pair/test_project_shims.py"]},
    {"paths": ["evals/pr-pair/test_workflow_parity.py"], "suites": ["pr-pair/test_workflow_parity.py", "pr-pair/test_workflow_transport.py"]},
    {"paths": ["evals/pr-pair/test_workflow_transport.py"], "suites": ["pr-pair/test_workflow_transport.py"]},
    {"paths": ["cli/lib/src/fence/**", "cli/lib/src/pr/gh.dart", "cli/lib/src/commands/as.dart", "cli/test/fence/**", "cli/test/helper_support.dart"], "suites": ["pr-pair", "vcs"]},
    {"paths": ["cli/lib/src/pr/**", "cli/lib/src/commands/pr.dart", "cli/test/pr/**"], "suites": ["pr-pair"]},
    {"paths": ["cli/lib/src/settings/**", "cli/test/settings/**"], "suites": ["pr-pair", "vcs"]},
    {"paths": ["cli/lib/src/commit/**", "cli/test/commit/**"], "suites": ["git-workflow", "vcs"]},
    {"paths": ["cli/lib/src/finish/**", "cli/lib/src/commands/finish.dart", "cli/test/finish/**"], "suites": ["finish", "vcs"]},
    {"paths": ["evals/vcs/**", "skills/specwright-pr/scripts/vcs.sh", "skills/specwright-pr/scripts/pr-pair.sh", "skills/specwright-pr/scripts/as.sh", "skills/specwright-review/scripts/review-run.sh", "skills/specwright-release/scripts/release.sh", "skills/specwright-finish/scripts/finish.sh"], "suites": ["vcs"]}
  ],
  "no_eval": [
    ".gitattributes",
    "LICENSE",
    "docs/**"
  ]
}
